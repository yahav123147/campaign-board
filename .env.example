# Copy this file to .env.local and fill only the settings you need.
# Never put API keys, access tokens, passwords, or client data in this file.

# Absolute path to a private, regular JSON file based on the checked-in example.
# Dotenv does not expand ~ or $HOME, so write the complete absolute path.
CAMPAIGN_COUNCIL_CLIENT_PROFILE=

# Safe UI-only development mode. Keep 0 when a real profile is configured.
CAMPAIGN_COUNCIL_USE_DEVELOPMENT_PROFILE=0

# Optional absolute, dedicated base directory for client data. Broad home,
# filesystem-root, workspace-root, and temporary-root targets are refused. If
# empty, the app uses the private application-data directory for the OS.
CAMPAIGN_COUNCIL_DATA_DIR=

# Required only when Stage 5 landing-page builds are explicitly enabled.
# Stage 5 requires the native macOS sandbox in this release. This value must
# match landing.workspacePath in the client profile exactly.
LANDING_PAGES_DIR=

# Both services bind to 127.0.0.1. Use different, unreserved ports. Set
# PREVIEW_PORT before build and keep it unchanged at start because CSP pins it.
PORT=3000
PREVIEW_PORT=4322

# Do not put a Meta access token here. Stage 8 reads it only from the macOS
# Keychain service named by meta.tokenKeychainService in the private profile.
# Optional version-only override for a supported Meta Graph API release. The
# hostname is fixed in code and cannot be overridden. Current default: v26.0.
META_GRAPH_API_VERSION=v26.0

# Do not set ANTHROPIC_API_KEY or another paid Claude provider variable.
# Campaign Council supports `claude -p` through first-party OAuth from
# `claude auth login`, using an active MAX subscription only.
# Claude model for every agent turn (claude -p). Leave empty for the CLI default.
# Verify availability on your plan first: claude -p --model <id> "hi"
CAMPAIGN_COUNCIL_AGENT_MODEL=
